FROM golang:1.25-alpine AS builder

ARG VERSION=2.8
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HardwareStatus

WORKDIR /src/server

COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/*.go ./
COPY server/contracts ./contracts

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${VCS_REF} -X main.buildTime=${BUILD_DATE}" \
    -o /out/hardwarestatus-server .

FROM alpine:3.22

ARG VERSION=2.8
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/404404/HardwareStatus
ARG CATALOG_REVISION=3e090d8a18f11a76085914bd8fa44f1c4a9b039b
ARG CATALOG_SCHEMA_VERSION=2
ARG CATALOG_SHA256=ba59930b18e88df78bef35cc51ee2ba897169fb8cdcae20465aa69878c6664fa

LABEL maintainer="cppla <https://cpp.la>" \
    org.opencontainers.image.title="HardwareStatus Server" \
    org.opencontainers.image.description="HardwareStatus Go server and read-only dashboard" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.source="${SOURCE_URL}" \
    org.opencontainers.image.licenses="MIT" \
    io.hardwarestatus.component="server" \
    io.hardwarestatus.unifi.catalog.revision="${CATALOG_REVISION}" \
    io.hardwarestatus.unifi.catalog.schema_version="${CATALOG_SCHEMA_VERSION}" \
    io.hardwarestatus.unifi.catalog.sha256="${CATALOG_SHA256}"

RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /app/config /app/data /app/web

COPY --from=builder /out/hardwarestatus-server /usr/local/bin/hardwarestatus-server
RUN ln -s /usr/local/bin/hardwarestatus-server /usr/local/bin/serverstatus
COPY server/config.json /app/config/config.json
COPY web /app/web/

ENV TZ=Asia/Shanghai

EXPOSE 80 35601

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/api/health || exit 1

ENTRYPOINT ["/usr/local/bin/hardwarestatus-server"]
