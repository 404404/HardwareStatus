[Unit]
# Legacy unit for existing /usr/local/ServerStatus installations. New installs
# should use hardwarestatus-client.service; this unit is intentionally retained.
Description=Legacy ServerStatus-Client
After=network.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/ServerStatus/clients/client-linux.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
[Install]
WantedBy=multi-user.target
